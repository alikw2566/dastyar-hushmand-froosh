ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://mokalemeban:mokalemeban@postgres:5432/mokalemeban
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=mokalemeban
S3_SECRET_KEY=replace-in-secret-store
S3_BUCKET=sales-calls
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
ANALYSIS_MODEL=gpt-4o
OIDC_ISSUER=http://keycloak:8080/realms/mokalemeban
OIDC_AUDIENCE=mokalemeban-api
AUTH_DISABLED=false
DEFAULT_TENANT_NAME=
DEFAULT_TENANT_ID=
SECRET_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000

# Issabel/Asterisk. For a mounted SMB share use SHARED_FOLDER and its local mount path.
ISSABEL_IMPORT_MODE=disabled
ISSABEL_RECORDINGS_PATH=/recordings
ISSABEL_SFTP_HOST=
ISSABEL_SFTP_PORT=22
ISSABEL_SFTP_USERNAME=
ISSABEL_SFTP_PASSWORD=
ISSABEL_SFTP_PRIVATE_KEY=
ISSABEL_SFTP_REMOTE_PATH=/var/spool/asterisk/monitor
ISSABEL_POLL_INTERVAL=30
ISSABEL_FILE_STABILITY_SECONDS=15
ISSABEL_ALLOWED_EXTENSIONS=.wav,.mp3,.gsm
ISSABEL_QUARANTINE_PATH=/recordings/quarantine
ISSABEL_FILENAME_PATTERN=
ISSABEL_DEFAULT_TENANT_ID=
ISSABEL_TEMPORARY_EXTENSIONS=.tmp,.part,.partial,.download
ISSABEL_CDR_DATABASE_URL=
ISSABEL_CDR_TABLE=cdr
ISSABEL_CDR_MATCH_WINDOW_SECONDS=180

AUDIO_MIN_DURATION_SECONDS=1
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_FFMPEG_PATH=ffmpeg
AUDIO_FFPROBE_PATH=ffprobe
PROCESSING_MAX_RETRIES=5
PROCESSING_RETRY_SCHEDULE_SECONDS=30,120,600,1800,7200
PROCESSING_STAGE_TIMEOUT_SECONDS=1800
WATCHER_STALE_AFTER_SECONDS=120
WORKER_STALE_AFTER_SECONDS=300
PDF_FONT_PATH=
LOG_LEVEL=INFO
