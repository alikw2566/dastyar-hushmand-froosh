# Company Issabel / MariaDB (read-only)
ISSABEL_DB_HOST=192.168.1.14
ISSABEL_DB_PORT=3306
ISSABEL_DB_NAME=asteriskcdrdb
ISSABEL_DB_USER=issabel_reader
ISSABEL_DB_PASSWORD=change-me

# Issabel recordings over SFTP (read-only)
ISSABEL_SFTP_HOST=192.168.1.14
ISSABEL_SFTP_PORT=22
ISSABEL_SFTP_USER=issabel_audio
ISSABEL_SFTP_PASSWORD=change-me
ISSABEL_SFTP_ROOT=/recordings

# Mokalemeban Railway API
MOKALEMEBAN_API_URL=https://your-api.up.railway.app
# Leave blank while Railway backend is running with AUTH_DISABLED=true in development.
# Later set a real service-account bearer token when auth is enabled.
MOKALEMEBAN_BEARER_TOKEN=

# Polling / local bridge state
POLL_INTERVAL_SECONDS=60
RECORDING_STABILITY_SECONDS=5
QUERY_OVERLAP_MINUTES=10
STATE_DB_PATH=bridge_state.sqlite3
TEMP_DIR=tmp_audio
