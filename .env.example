ENVIRONMENT=development
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=mokalemeban
S3_SECRET_KEY=change-me-now
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-now
KEYCLOAK_DB_PASSWORD=change-me-keycloak
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=
DEFAULT_TENANT_NAME=شرکت پایلوت
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AUTH_DISABLED=false
SECRET_ENCRYPTION_KEY=

# Issabel/Asterisk ingestion. Mount the host/network share with
# ISSABEL_HOST_RECORDINGS_PATH and keep the in-container path unchanged.
ISSABEL_IMPORT_MODE=shared_folder
ISSABEL_HOST_RECORDINGS_PATH=./sample-recordings
ISSABEL_RECORDINGS_PATH=/recordings
ISSABEL_SFTP_HOST=
ISSABEL_SFTP_PORT=22
ISSABEL_SFTP_USERNAME=
ISSABEL_SFTP_PASSWORD=
ISSABEL_SFTP_PRIVATE_KEY=
ISSABEL_SFTP_REMOTE_PATH=/var/spool/asterisk/monitor
ISSABEL_POLL_INTERVAL=10
ISSABEL_FILE_STABILITY_SECONDS=15
ISSABEL_ALLOWED_EXTENSIONS=.wav,.mp3,.gsm
ISSABEL_QUARANTINE_PATH=/quarantine
# This UUID must match DEFAULT_TENANT_ID so imported calls belong to the
# organization created by the first-admin bootstrap command.
ISSABEL_DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
ISSABEL_FILENAME_PATTERN=
ISSABEL_TEMPORARY_EXTENSIONS=.tmp,.part,.partial,.download
ISSABEL_CDR_DATABASE_URL=
ISSABEL_CDR_TABLE=cdr
ISSABEL_CDR_MATCH_WINDOW_SECONDS=180

# Processing and retry policy (seconds).
PROCESSING_STAGE_TIMEOUT_SECONDS=1800
PROCESSING_MAX_RETRIES=5
PROCESSING_RETRY_SCHEDULE_SECONDS=30,120,600,1800,7200
AUDIO_MIN_DURATION_SECONDS=2
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_FFMPEG_PATH=ffmpeg
AUDIO_FFPROBE_PATH=ffprobe
WATCHER_STALE_AFTER_SECONDS=120
WORKER_STALE_AFTER_SECONDS=300

# Pilot operations.
CORS_ORIGINS=http://localhost:3000
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
BACKUP_RETENTION_DAYS=14
